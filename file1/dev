<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Ravan Reddy - Resume</title>

  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: #f5f5f2;
      color: #222;
      line-height: 1.6;
    }

    .resume {
      max-width: 1000px;
      margin: 40px auto;
      background: white;
      padding: 50px;
      box-shadow: 0 10px 35px rgba(0,0,0,0.08);
      border-radius: 14px;
    }

    /* Header */
    .header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid #ddd;
      padding-bottom: 25px;
    }

    .name {
      font-size: 42px;
      font-weight: 700;
      letter-spacing: -1px;
    }

    .role {
      margin-top: 5px;
      color: #666;
      font-size: 18px;
    }

    .contact {
      text-align: right;
      font-size: 14px;
      color: #555;
    }

    .contact div {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 7px;
      margin: 5px 0;
    }

    /* Tree Layout */
    .tree {
      position: relative;
      margin-top: 45px;
    }

    /* Main tree trunk */
    .tree::before {
      content: "";
      position: absolute;
      left: 50%;
      top: 0;
      bottom: 0;
      width: 2px;
      background: #222;
      transform: translateX(-50%);
    }

    .section {
      width: 46%;
      padding: 22px;
      margin-bottom: 35px;
      background: #fafafa;
      border: 1px solid #e5e5e5;
      border-radius: 12px;
      position: relative;
    }

    .section:nth-child(odd) {
      margin-right: auto;
    }

    .section:nth-child(even) {
      margin-left: auto;
    }

    /* Branch */
    .section::after {
      content: "";
      position: absolute;
      top: 35px;
      width: 35px;
      height: 2px;
      background: #222;
    }

    .section:nth-child(odd)::after {
      right: -35px;
    }

    .section:nth-child(even)::after {
      left: -35px;
    }

    /* Tree Node */
    .section::before {
      content: "";
      position: absolute;
      top: 27px;
      width: 14px;
      height: 14px;
      background: white;
      border: 3px solid #222;
      border-radius: 50%;
      z-index: 2;
    }

    .section:nth-child(odd)::before {
      right: -43px;
    }

    .section:nth-child(even)::before {
      left: -43px;
    }

    .section-title {
      display: flex;
      align-items: center;
      gap: 9px;
      font-size: 20px;
      margin-bottom: 15px;
    }

    .section-title i {
      width: 21px;
      height: 21px;
    }

    .item {
      margin-bottom: 16px;
    }

    .item:last-child {
      margin-bottom: 0;
    }

    .item h3 {
      font-size: 16px;
      margin-bottom: 3px;
    }

    .item span {
      color: #777;
      font-size: 13px;
    }

    .item p {
      font-size: 14px;
      color: #555;
      margin-top: 5px;
    }

    /* Skills */
    .skills {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .skill {
      border: 1px solid #ccc;
      padding: 6px 12px;
      border-radius: 20px;
      font-size: 13px;
      background: white;
    }

    /* Footer */
    .footer {
      text-align: center;
      margin-top: 35px;
      padding-top: 20px;
      border-top: 1px solid #ddd;
      color: #777;
      font-size: 13px;
    }

    /* Mobile */
    @media (max-width: 700px) {

      .resume {
        margin: 10px;
        padding: 25px;
      }

      .header {
        flex-direction: column;
        align-items: flex-start;
        gap: 15px;
      }

      .contact {
        text-align: left;
      }

      .contact div {
        justify-content: flex-start;
      }

      .name {
        font-size: 32px;
      }

      .tree::before {
        left: 8px;
      }

      .section,
      .section:nth-child(odd),
      .section:nth-child(even) {
        width: calc(100% - 30px);
        margin-left: 30px;
        margin-right: 0;
      }

      .section::after {
        left: -30px !important;
        right: auto !important;
        width: 30px;
      }

      .section::before {
        left: -38px !important;
        right: auto !important;
      }
    }

    /* Print */
    @media print {
      body {
        background: white;
      }

      .resume {
        margin: 0;
        box-shadow: none;
        max-width: none;
      }
    }
  </style>
</head>

